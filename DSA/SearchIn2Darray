class Search2D{
    public static void main(String[] args){
         int [][] mat={
           {10,20,30},
           {40,50,60},
           {70,80,90}
         };

  int target=50;     
  boolean found=false;

  for(int i=0;i<mat.length;i++){
    for(int j=0;j<mat[i].length;i++){
         if(mat[i][j] = target){
           System.out.println("Found at("+i"',+j+")");
           found=true;
      }
   }
if(!found){   
     System.out.println("Not found");
  }
}
}
}
