Class Stack{
   int top= -1,Size=5;
   int arr[] = new int(Size);

   void push(int x){
      if(top==size-1){
        System.out.println("Stack Overflow");
        return;
       }
      arr[++top]=x;
    }

  int pop(){
     if(top== -1){
       System.out.println("Stack underflow");
      return -1;
     }
    return arr[top--];
   }
}
