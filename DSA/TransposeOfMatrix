class Transpose{
  public static void main(String[] args){
      int[][]  mat={
        {1,2,3},
        {4,5,6},
        {7,8,9}
       ];

  int n=mat.length;

 for(int i=0;i<n;i++){
     for(int j=i;j<n;j++){
      int temp = mat[i][j];
      mat[i][j]=mat[j][i];
      mat[j][i]=temp;
    }
  }

 for(int i=0;i<n;i++){
    for(int j=i;j<n;j++){
       System.out.println(mat[i][j] + " ");
     }
   System.out.println();
  }
}
}
